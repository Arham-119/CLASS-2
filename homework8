def calculator():
    print("Welcome to the Calculator!")
    print("--------------------------------")
    
    # Using a while True loop to keep the calculator running indefinitely
    while True:
        try:
            # Step 1: Gather user inputs
            # Request the first number with an option to exit the program gracefully
            num1_input = input("\nEnter the first number (or type 'exit' to quit): ").strip()
            
            if num1_input.lower() == 'exit':
                print("Thank you for using the calculator. Goodbye!")
                break  # Breaks out of the infinite loop to end the program
                
            # Convert the input string into a floating-point number for decimal support
            num1 = float(num1_input)
            
            # Request the mathematical operator
            operator = input("Choose an operator (+, -, *, /): ").strip()
            
            # Request the second number
            num2_input = input("Enter the second number: ").strip()
            num2 = float(num2_input)
            
            # Step 2: Conditional logic (Equivalent to Scratch If-Then-Else blocks)
            if operator == '+':
                result = num1 + num2
                print(f"Result: {num1} + {num2} = {result}")
                
            elif operator == '-':
                result = num1 - num2
                print(f"Result: {num1} - {num2} = {result}")
                
            elif operator == '*':
                result = num1 * num2
                print(f"Result: {num1} * {num2} = {result}")
                
            elif operator == '/':
                # Error Handling: Prevent division by zero crashes
                if num2 == 0:
                    print("Error: Division by zero is not allowed!")
                else:
                    result = num1 / num2
                    print(f"Result: {num1} / {num2} = {result}")
            else:
                # Error Handling: Fallback for typing errors or unsupported operators
                print("Error: Invalid operator! Please use +, -, *, or /.")
                
        except ValueError:
            # Error Handling: Catch cases where user text cannot be converted to a number
            print("Error: Invalid input! Please enter numeric digits.")

if __name__ == "__main__":
    # Start the application
    calculator()