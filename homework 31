import pygame

pygame.init()

# 1. Window size (500, 500)
screen = pygame.display.set_mode((500, 500))

# 2. Caption
pygame.display.set_caption("My first game screen")

# 3. Load the image, resize it to 300x300, and centre it
image = pygame.image.load("image.png")  # use your image's file name
image = pygame.transform.scale(image, (300, 300))
image_rect = image.get_rect(center=(250, 250))  # same as position (100, 100)

# 4. Grey background (58, 58, 58)
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    screen.fill((58, 58, 58))
    screen.blit(image, image_rect)
    pygame.display.update()

pygame.quit()