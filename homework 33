import pygame

pygame.init()

# Window size and caption (check these against the Story section)
screen = pygame.display.set_mode((640, 480))
pygame.display.set_caption("My first game screen")

clock = pygame.time.Clock()

# Colours (swap for whatever the Story asks for)
BACKGROUND = (255, 255, 255)
PLAYER_COLOR = (30, 144, 255)   # blue, the sprite you control
OTHER_COLOR = (220, 20, 60)     # red, the sprite that stays still

# Two rectangular sprites: Rect(x, y, width, height)
player = pygame.Rect(100, 200, 60, 60)
other = pygame.Rect(400, 200, 60, 60)

speed = 5

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Controls: arrow keys move the player sprite
    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]:
        player.x -= speed
    if keys[pygame.K_RIGHT]:
        player.x += speed
    if keys[pygame.K_UP]:
        player.y -= speed
    if keys[pygame.K_DOWN]:
        player.y += speed

    # Keep the player inside the window
    player.clamp_ip(screen.get_rect())

    # Draw: background first, then sprites
    screen.fill(BACKGROUND)
    pygame.draw.rect(screen, PLAYER_COLOR, player)
    pygame.draw.rect(screen, OTHER_COLOR, other)
    pygame.display.update()

    clock.tick(60)  # 60 frames per second

pygame.quit()